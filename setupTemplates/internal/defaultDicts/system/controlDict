FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     <SOLVER>;
startFrom       <STARTFROM>;
startTime       0;
stopAt          endTime;
endTime         <ENDTIME>;
deltaT          <INIT_DT>;
writeControl    adjustable;
writeInterval   <WRITE_INTERVAL>;
purgeWrite      0;
writeFormat     binary;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           <MAX_CO>;
maxDeltaT       <MAX_DT>;

functions
{
    #include "internalFunctionObjects"
}

