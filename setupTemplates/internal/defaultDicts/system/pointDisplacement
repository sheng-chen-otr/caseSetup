FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointDisplacement;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//required by displacementInterpolation, but its BCs are not used (motion comes from the zone tables)
dimensions      [0 1 0 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    //processor/cyclic patches by patch group
    #includeEtc "caseDicts/setConstraintTypes"
    ".*"
    {
        type            calculated;
        value           uniform (0 0 0);
    }
}

