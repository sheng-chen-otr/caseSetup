FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "rho.*"     { solver diagonal; }
    "(p|p_rgh)" { solver GAMG; smoother GaussSeidel; tolerance 1e-8; relTol <P_RELTOL>; }
    "(p|p_rgh)Final" { solver GAMG; smoother GaussSeidel; tolerance 1e-8; relTol 0; }
    "(U|e|k|omega|epsilon).*" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-8; relTol <U_RELTOL>; }
}

<ALGORITHM>

<RELAXATION>
