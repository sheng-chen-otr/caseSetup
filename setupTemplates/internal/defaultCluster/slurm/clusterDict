{
    "run": {
        "shebang": "#!/bin/bash",
        "header": "#SBATCH --account=<ACCOUNT>\n#SBATCH --job-name=<JOB_NAME>\n#SBATCH --nodes=<NODES>\n#SBATCH --ntasks=<NUM_PROCS>\n#SBATCH --mem=0\n#SBATCH --time=<RUN_TIME>\n#SBATCH --output=01_%x_%j.out\n#SBATCH --exclusive",
        "usage": "#mesh + solve + export in one job, as a Slurm job (sbatch runScript) or locally (./runScript, <LOCAL_PROCS> cores)\n#  --meshOnly  stop after the mesh (then ./motionCheckScript for the mesh motion dry run)\n#  the mesh is kept (.meshDone): running again skips the meshing and continues the solve from the latest time,\n#  rm -r processor* .meshDone to remesh\n#  afterwards ./postScript (summary, images, videos), submitScript chains it on the cluster",
        "environment": "cd \"${SLURM_SUBMIT_DIR:-$(dirname \"$0\")}\" || exit 1;\nif [ -n \"$SLURM_JOB_ID\" ]; then module --force purge; module load <MODULES>; NP=$SLURM_NTASKS; RUN=\"<MPI_RUN>\"; else NP=<LOCAL_PROCS>; RUN=\"mpirun -np $NP\"; fi;\nMESHONLY=no; if [ \"$1\" = \"--meshOnly\" ]; then MESHONLY=yes; fi;",
        "meshStart": "if [ -f .meshDone ] && [ -s .meshDone ] && ! cmp -s system/meshSignature .meshDone; then echo 'ERROR: the mesh is older than the setup (geometry, snappy dicts or motion zones changed since it was made): rm -r processor* .meshDone and run again to remesh'; exit 1; fi;\nif [ ! -f .meshDone ]; then\n<SET_DECOMP>",
        "blockMesh": "echo 'running blockMesh...'; blockMesh > log.blockMesh 2>&1; if [ $? != 0 ]; then echo 'blockMesh failed'; exit 1; fi;",
        "surfaceFeatureExtract": "echo 'running surfaceFeatureExtract...'; surfaceFeatureExtract > log.surfaceFeatureExtract 2>&1; if [ $? != 0 ]; then echo 'surfaceFeatureExtract failed'; exit 1; fi;",
        "decomposePar": "echo 'running decomposePar...'; decomposePar -force -constant > log.decomposePar 2>&1; if [ $? != 0 ]; then echo 'decomposePar failed'; exit 1; fi;",
        "snappyHexMesh": "echo 'running snappyHexMesh...'; $RUN snappyHexMesh -parallel -overwrite > log.snappyHexMesh 2>&1; if [ $? != 0 ]; then echo 'snappyHexMesh failed'; exit 1; fi;",
        "topoSet": "echo 'running topoSet (motion zones)...'; $RUN topoSet -parallel > log.topoSet 2>&1; if [ $? != 0 ]; then echo 'topoSet failed'; exit 1; fi;",
        "reorderFaceZones": "echo 'reordering faceZones (motion zones first)...'; python3 '<EXEC_DIR>/meshUtilities/reorderFaceZones.py' <MOTION_ZONES> > log.reorderFaceZones 2>&1; if [ $? != 0 ]; then cat log.reorderFaceZones; exit 1; fi;",
        "checkMesh": "echo 'running checkMesh...'; $RUN checkMesh -parallel > log.checkMesh 2>&1; grep -E 'cells:|Failed|Mesh OK' log.checkMesh;",
        "remeshMesh": "echo 'making the remeshing meshes (system/remeshSegments)...'; mkdir -p meshes/seg01; rm -rf meshes/seg01/system meshes/seg01/processor*; cp -r system meshes/seg01/system; for d in processor*; do mkdir -p meshes/seg01/$d; cp -r $d/constant meshes/seg01/$d/; done;\nfor s in $(awk '!/^#/ && $1 != \"seg01\" {print $1}' system/remeshSegments); do echo \"  meshing $s...\"; (cd meshes/$s && rm -rf system processor* constant/polyMesh constant/extendedFeatureEdgeMesh && cp -r ../../system system && blockMesh > log.blockMesh 2>&1 && surfaceFeatureExtract > log.surfaceFeatureExtract 2>&1 && decomposePar -force -constant > log.decomposePar 2>&1 && $RUN snappyHexMesh -parallel -overwrite > log.snappyHexMesh 2>&1 && $RUN topoSet -parallel > log.topoSet 2>&1 && python3 '<EXEC_DIR>/meshUtilities/reorderFaceZones.py' <MOTION_ZONES> > log.reorderFaceZones 2>&1); if [ $? != 0 ]; then echo \"meshing $s failed, see meshes/$s/log.*\"; exit 1; fi; (cd meshes/$s && $RUN checkMesh -parallel > log.checkMesh 2>&1); grep -E 'cells:|Failed|Mesh OK' meshes/$s/log.checkMesh; done;",
        "meshEnd": "cp system/meshSignature .meshDone;\nelse echo 'mesh exists (.meshDone), skipping the meshing';\nfi;",
        "meshOnly": "if [ $MESHONLY = yes ]; then echo 'mesh done (--meshOnly)'; exit 0; fi;",
        "compileLib": "echo 'compiling libstirlingMotion (crank drive, sliding walls)...'; (cd '<EXEC_DIR>/foamLibs/stirlingMotion' && wmake libso) > log.wmakeStirlingMotion 2>&1; if [ $? != 0 ]; then echo 'compiling libstirlingMotion failed, see log.wmakeStirlingMotion'; exit 1; fi;",
        "compileMassFix": "echo 'compiling remeshMassFix...'; (cd '<EXEC_DIR>/foamLibs/remeshMassFix' && wmake) > log.wmakeRemeshMassFix 2>&1; if [ $? != 0 ]; then echo 'compiling remeshMassFix failed, see log.wmakeRemeshMassFix'; exit 1; fi;",
        "checkDecomposition": "NPD=$(ls -d processor[0-9]* | wc -l); if [ $NPD != $NP ]; then echo \"case is decomposed into $NPD but this run has $NP tasks\"; exit 1; fi; <SET_DECOMP>",
        "createZeroDir": "caseTemplates='<ZERO_TEMPLATES>'; if [ ! -f processor0/0/p ]; then echo 'creating zero directories...'; $RUN createZeroDirectory -parallel -templateDir \"$caseTemplates\" > log.createZeroDirectory 2>&1; if [ $? != 0 ]; then echo 'createZeroDirectory failed'; exit 1; fi; fi;",
        "createBaffles": "if ! grep -q '_master' processor0/constant/polyMesh/boundary; then echo 'creating fan baffles...'; $RUN createBaffles -parallel -overwrite > log.createBaffles 2>&1; if [ $? != 0 ]; then echo 'createBaffles failed'; exit 1; fi; fi;",
        "pointDisplacement": "for d in processor*; do cp system/pointDisplacement $d/0/pointDisplacement; done;",
        "solve": "n=1; while [ -f log.<SOLVER>.$n ]; do n=$((n+1)); done; if [ -f log.<SOLVER> ]; then mv log.<SOLVER> log.<SOLVER>.$n; fi; echo 'running <SOLVER>...'; $RUN <SOLVER> -parallel > log.<SOLVER> 2>&1; if [ $? != 0 ]; then echo '<SOLVER> failed'; exit 1; fi;",
        "remeshSolve": "rm -f .remeshState; REMESH='<EXEC_DIR>/meshUtilities/remeshRun.py'; while true; do step=$(python3 \"$REMESH\" next); if [ $? != 0 ]; then echo \"$step\"; exit 1; fi; set -- $step; if [ \"$1\" = done ]; then break; fi;\nif [ \"$1\" = map ]; then echo \"remeshing at t = $3: mapping onto $2...\"; python3 \"$REMESH\" prepare $2 $3 || exit 1; $RUN remeshMassFix -parallel -time $3 -writeCover > log.remeshCover.$3 2>&1; if [ $? != 0 ]; then echo \"remeshMassFix -writeCover failed, see log.remeshCover.$3\"; exit 1; fi; MASS=$(awk '/^gasMass/{print $2}' log.remeshCover.$3); if [ <MASS_FIX> = yes ] && [ -z \"$MASS\" ]; then echo 'no gas mass before the map, see log.remeshCover.'$3; exit 1; fi;\n(cd meshes/$2 && $RUN mapFieldsPar ../.. -sourceTime $3 -consistent -mapMethod cellVolumeWeight -patchMapMethod nearestFaceAMI -parallel) > log.mapFieldsPar.$3 2>&1; if [ $? != 0 ]; then echo \"mapFieldsPar failed, see log.mapFieldsPar.$3\"; exit 1; fi;\npython3 \"$REMESH\" graft $2 $3 || exit 1;\nif [ <MASS_FIX> = yes ]; then MASSARG=\"-mass $MASS\"; else MASSARG=''; fi; $RUN remeshMassFix -parallel -time $3 -combine $MASSARG > log.remeshMassFix.$3 2>&1; if [ $? != 0 ]; then echo \"remeshMassFix failed, see log.remeshMassFix.$3\"; exit 1; fi; grep -E 'coverage|combined|matrix|scaled' log.remeshMassFix.$3;\ncontinue; fi;\nn=1; while [ -f log.<SOLVER>.$n ]; do n=$((n+1)); done; if [ -f log.<SOLVER> ]; then mv log.<SOLVER> log.<SOLVER>.$n; fi; echo \"running <SOLVER> on $2 from t = $3...\"; $RUN <SOLVER> -parallel > log.<SOLVER> 2>&1; if [ $? != 0 ]; then echo '<SOLVER> failed'; exit 1; fi; done;",
        "export": "echo 'exporting EnSight (all times)...'; $RUN foamToEnsight -parallel -noZero > log.foamToEnsight 2>&1; if [ $? != 0 ]; then echo 'foamToEnsight failed'; exit 1; fi;",
        "done": "echo 'run done';"
    },
    "motionCheck": {
        "shebang": "#!/bin/bash",
        "header": "#SBATCH --account=<ACCOUNT>\n#SBATCH --job-name=<JOB_NAME>_motion\n#SBATCH --nodes=<NODES>\n#SBATCH --ntasks=<NUM_PROCS>\n#SBATCH --mem=0\n#SBATCH --time=<MOTION_TIME>\n#SBATCH --output=02_%x_%j.out\n#SBATCH --exclusive",
        "usage": "#mesh motion dry run over one cycle on the mesh from runScript --meshOnly (sbatch or ./motionCheckScript)\n#  checkMesh every 45 deg, the moved meshes are exported to EnSightMotion for ./postScript --mesh (images, videos)",
        "environment": "cd \"${SLURM_SUBMIT_DIR:-$(dirname \"$0\")}\" || exit 1;\nNP=$(ls -d processor[0-9]* 2>/dev/null | wc -l); if [ $NP = 0 ]; then echo \"no processor directories, run runScript --meshOnly first\"; exit 1; fi;\nif [ -n \"$SLURM_JOB_ID\" ]; then module --force purge; module load <MODULES>; if [ $SLURM_NTASKS != $NP ]; then echo \"job has $SLURM_NTASKS tasks but the case is decomposed into $NP\"; exit 1; fi; RUN=\"<MPI_RUN>\"; else RUN=\"mpirun -np $NP\"; fi; <SET_DECOMP>\nif [ -f .meshDone ] && [ -s .meshDone ] && ! cmp -s system/meshSignature .meshDone; then echo 'ERROR: the mesh is older than the setup (geometry, snappy dicts or motion zones changed since it was made): rm -r processor* .meshDone and run again to remesh'; exit 1; fi;",
        "pointDisplacement": "if [ -n \"$(find processor0 -mindepth 1 -maxdepth 1 -type d -regex '.*/[0-9.e+-]+' ! -name 0)\" ]; then echo 'processor0 has time directories (solver results?), the motion check would overwrite and remove them: move them away first'; exit 1; fi; for d in processor*; do mkdir -p $d/0; cp system/pointDisplacement $d/0/pointDisplacement; done;",
        "compileLib": "echo 'compiling libstirlingMotion (crank drive, sliding walls)...'; (cd '<EXEC_DIR>/foamLibs/stirlingMotion' && wmake libso) > log.wmakeStirlingMotion 2>&1; if [ $? != 0 ]; then echo 'compiling libstirlingMotion failed, see log.wmakeStirlingMotion'; exit 1; fi;",
        "moveDynamicMesh": "echo 'running moveDynamicMesh over one cycle...'; cp system/controlDict system/controlDict.solve; trap 'cp system/controlDict.solve system/controlDict' EXIT TERM; cp system/controlDictMotion system/controlDict; $RUN moveDynamicMesh -parallel > log.moveDynamicMesh 2>&1; status=$?; cp system/controlDict.solve system/controlDict; if [ $status != 0 ]; then echo 'moveDynamicMesh failed'; exit 1; fi;",
        "checkMesh": "echo 'running checkMesh on the moved meshes (every 45 deg)...'; $RUN checkMesh -parallel -time '<CHECK_TIMES>' > log.checkMeshMotion 2>&1; if [ $? != 0 ]; then echo 'checkMesh failed, see log.checkMeshMotion'; fi; grep -E '^Time = |Failed|Mesh OK|Max skewness|Max aspect' log.checkMeshMotion;",
        "exportMesh": "echo 'exporting the moved meshes to EnSightMotion...'; rm -rf EnSightMotion; $RUN foamToEnsight -parallel -name EnSightMotion -fields '(none)' > log.foamToEnsightMotion 2>&1; if [ $? != 0 ]; then echo 'foamToEnsight failed, see log.foamToEnsightMotion (no mesh images)'; fi;",
        "clean": "for d in processor*; do find $d -mindepth 1 -maxdepth 1 -type d -regex '.*/[0-9.e+-]+' ! -name 0 -exec rm -rf {} +; done; echo 'motion check done (moved meshes removed)';"
    },
    "post": {
        "shebang": "#!/bin/bash",
        "header": "#SBATCH --account=<ACCOUNT>\n#SBATCH --job-name=<JOB_NAME>_post\n#SBATCH --nodes=1\n#SBATCH --ntasks=1\n#SBATCH --cpus-per-task=<POST_CPUS>\n#SBATCH --mem=<POST_MEM>\n#SBATCH --time=<POST_TIME>\n#SBATCH --output=03_%x_%j.out",
        "usage": "#post-processing after runScript, as a Slurm job (sbatch postScript) or locally (./postScript):\n#  summary and plots (postInternal.py -> summary.csv, pV.png, cycleConvergence.png), gsheet row, images (pvbatch pvPostInternal.py,\n#  settings in pvPostInternalSetup) and one video per image panel (imagesToMovies.py, ffmpeg)\n#  then the run data is copied back to Google Drive (copyBackInternal.py, COPY_BACK)\n#  a failed step is reported and the next one still runs\n#  ./postScript --mesh   only the mesh images and videos of the motion dry run (EnSightMotion)",
        "environment": "cd \"${SLURM_SUBMIT_DIR:-$(dirname \"$0\")}\" || exit 1;\nif [ -n \"$SLURM_JOB_ID\" ]; then module --force purge; module load <POST_MODULES>; fi;\nSTATUS=0;",
        "meshImages": "if [ \"$1\" = \"--mesh\" ]; then\nif ! ls EnSightMotion/*.case > /dev/null 2>&1; then echo 'no EnSightMotion: run motionCheckScript first'; exit 1; fi;\necho 'mesh images of the motion dry run...'; <PVBATCH> --force-offscreen-rendering '<EXEC_DIR>/postUtilities/pvPostInternal.py' --mesh > log.pvPostMesh 2>&1; if [ $? != 0 ]; then echo 'pvPostInternal --mesh failed, see log.pvPostMesh'; exit 1; fi;\necho 'mesh videos...'; python3 '<EXEC_DIR>/postUtilities/imagesToMovies.py' --force --imageDir postProcessing/meshImages --movieDir postProcessing/meshMovies > log.meshMovies 2>&1; if [ $? != 0 ]; then echo 'imagesToMovies failed, see log.meshMovies'; exit 1; fi;\necho 'mesh images in postProcessing/meshImages, videos in postProcessing/meshMovies'; exit 0;\nfi;",
        "summary": "echo 'running postInternal (summary)...'; python3 '<EXEC_DIR>/postUtilities/postInternal.py' > log.postInternal 2>&1; if [ $? != 0 ]; then echo 'postInternal failed, see log.postInternal'; STATUS=1; fi;",
        "gsheet": "echo 'pushing the summary to the gsheet...';source ~/gdrive_env/bin/activate; python3 '<EXEC_DIR>/postUtilities/gsheetInternal.py' > log.gsheetInternal 2>&1; if [ $? != 0 ]; then echo 'gsheet push failed, see log.gsheetInternal'; STATUS=1; fi;",
        "images": "if ls EnSight/*.case > /dev/null 2>&1; then echo 'running pvPostInternal (images)...'; <PVBATCH> --force-offscreen-rendering '<EXEC_DIR>/postUtilities/pvPostInternal.py' > log.pvPostInternal 2>&1; if [ $? != 0 ]; then echo 'pvPostInternal failed, see log.pvPostInternal'; STATUS=1; fi; else echo 'no EnSight export, no images'; fi;",
        "movies": "if [ -d postProcessing/images ]; then echo 'making videos...'; python3 '<EXEC_DIR>/postUtilities/imagesToMovies.py' > log.imagesToMovies 2>&1; if [ $? != 0 ]; then echo 'imagesToMovies failed, see log.imagesToMovies'; STATUS=1; fi; fi;",
        "copyBack": "echo 'copying the run data back to Drive...'; python3 '<EXEC_DIR>/postUtilities/copyBackInternal.py' > log.copyBackInternal 2>&1; if [ $? != 0 ]; then echo 'copy back failed, see log.copyBackInternal'; STATUS=1; fi;",
        "done": "echo 'post done'; exit $STATUS;"
    },
    "submit": {
        "shebang": "#!/bin/bash",
        "usage": "#submits the case as Slurm jobs (from the case directory)\n#  ./submitScript          mesh + solve + export, then postScript (continues the solve if the mesh exists)\n#  ./submitScript --noPost the same without postScript\n#  ./submitScript --post   postScript only (e.g. after changing pvPostInternalSetup)\n#  ./submitScript --check  mesh only, the mesh motion dry run, then its mesh images and videos: look at them, then ./submitScript",
        "cd": "cd \"$(dirname \"$0\")\" || exit 1;",
        "check": "if [ \"$1\" = \"--check\" ]; then\njid=$(sbatch --parsable runScript --meshOnly) || exit 1; echo \"runScript --meshOnly  $jid\";",
        "motionCheck": "jid=$(sbatch --parsable --dependency=afterok:$jid motionCheckScript) || exit 1; echo \"motionCheckScript     $jid\";",
        "meshImages": "jid=$(sbatch --parsable --dependency=afterok:$jid postScript --mesh) || exit 1; echo \"postScript --mesh     $jid\";",
        "postOnly": "elif [ \"$1\" = \"--post\" ]; then\njid=$(sbatch --parsable postScript) || exit 1; echo \"postScript            $jid\";",
        "run": "else\njid=$(sbatch --parsable runScript) || exit 1; echo \"runScript             $jid\";",
        "post": "if [ \"$1\" != \"--noPost\" ]; then jid=$(sbatch --parsable --dependency=afterok:$jid postScript) || exit 1; echo \"postScript            $jid\"; fi;",
        "end": "fi;"
    }
}
