{
    "run": {
        "shebang": "#!/bin/bash",
        "header": "#SBATCH --account=<ACCOUNT>\n#SBATCH --job-name=<JOB_NAME>\n#SBATCH --nodes=<NODES>\n#SBATCH --ntasks=<NUM_PROCS>\n#SBATCH --mem=0\n#SBATCH --time=<RUN_TIME>\n#SBATCH --output=01_%x_%j.out\n#SBATCH --exclusive",
        "usage": "#mesh + solve + export in one job, as a Slurm job (sbatch runScript) or locally (./runScript, <LOCAL_PROCS> cores)\n#  --meshOnly  stop after the mesh (then ./motionCheckScript for the mesh motion dry run)\n#  the mesh is kept (.meshDone): running again skips the meshing and continues the solve from the latest time,\n#  rm -r processor* .meshDone to remesh",
        "environment": "cd \"${SLURM_SUBMIT_DIR:-$(dirname \"$0\")}\" || exit 1;\nif [ -n \"$SLURM_JOB_ID\" ]; then module --force purge; module load <MODULES>; NP=$SLURM_NTASKS; RUN=\"srun\"; else NP=<LOCAL_PROCS>; RUN=\"mpirun -np $NP\"; fi;\nMESHONLY=no; if [ \"$1\" = \"--meshOnly\" ]; then MESHONLY=yes; fi;",
        "meshStart": "if [ ! -f .meshDone ]; then\nfoamDictionary system/decomposeParDict -entry numberOfSubdomains -set $NP > /dev/null;",
        "blockMesh": "echo 'running blockMesh...'; blockMesh > log.blockMesh 2>&1; if [ $? != 0 ]; then echo 'blockMesh failed'; exit 1; fi;",
        "decomposePar": "echo 'running decomposePar...'; decomposePar -force -constant > log.decomposePar 2>&1; if [ $? != 0 ]; then echo 'decomposePar failed'; exit 1; fi;",
        "snappyHexMesh": "echo 'running snappyHexMesh...'; $RUN snappyHexMesh -parallel -overwrite > log.snappyHexMesh 2>&1; if [ $? != 0 ]; then echo 'snappyHexMesh failed'; exit 1; fi;",
        "topoSet": "echo 'running topoSet (motion zones)...'; $RUN topoSet -parallel > log.topoSet 2>&1; if [ $? != 0 ]; then echo 'topoSet failed'; exit 1; fi;",
        "reorderFaceZones": "echo 'reordering faceZones (motion zones first)...'; python3 '<EXEC_DIR>/meshUtilities/reorderFaceZones.py' <MOTION_ZONES> > log.reorderFaceZones 2>&1; if [ $? != 0 ]; then cat log.reorderFaceZones; exit 1; fi;",
        "checkMesh": "echo 'running checkMesh...'; $RUN checkMesh -parallel > log.checkMesh 2>&1; grep -E 'cells:|Failed|Mesh OK' log.checkMesh;",
        "meshEnd": "touch .meshDone;\nelse echo 'mesh exists (.meshDone), skipping the meshing';\nfi;",
        "meshOnly": "if [ $MESHONLY = yes ]; then echo 'mesh done (--meshOnly)'; exit 0; fi;",
        "checkDecomposition": "NPD=$(ls -d processor[0-9]* | wc -l); if [ $NPD != $NP ]; then echo \"case is decomposed into $NPD but this run has $NP tasks\"; exit 1; fi;",
        "createZeroDir": "caseTemplates='<ZERO_TEMPLATES>'; if [ ! -f processor0/0/p ]; then echo 'creating zero directories...'; $RUN createZeroDirectory -parallel -templateDir \"$caseTemplates\" > log.createZeroDirectory 2>&1; if [ $? != 0 ]; then echo 'createZeroDirectory failed'; exit 1; fi; fi;",
        "pointDisplacement": "for d in processor*; do cp system/pointDisplacement $d/0/pointDisplacement; done;",
        "solve": "echo 'running <SOLVER>...'; $RUN <SOLVER> -parallel > log.<SOLVER> 2>&1; if [ $? != 0 ]; then echo '<SOLVER> failed'; exit 1; fi;",
        "export": "echo 'exporting EnSight (all times)...'; $RUN foamToEnsight -parallel -noZero > log.foamToEnsight 2>&1; if [ $? != 0 ]; then echo 'foamToEnsight failed'; exit 1; fi;",
        "done": "echo 'run done';"
    },
    "motionCheck": {
        "shebang": "#!/bin/bash",
        "header": "#SBATCH --account=<ACCOUNT>\n#SBATCH --job-name=<JOB_NAME>_motion\n#SBATCH --nodes=<NODES>\n#SBATCH --ntasks=<NUM_PROCS>\n#SBATCH --mem=0\n#SBATCH --time=<MOTION_TIME>\n#SBATCH --output=02_%x_%j.out\n#SBATCH --exclusive",
        "usage": "#mesh motion dry run over one cycle on the mesh from runScript --meshOnly (sbatch or ./motionCheckScript)",
        "environment": "cd \"${SLURM_SUBMIT_DIR:-$(dirname \"$0\")}\" || exit 1;\nNP=$(ls -d processor[0-9]* 2>/dev/null | wc -l); if [ $NP = 0 ]; then echo \"no processor directories, run meshingScript first\"; exit 1; fi;\nif [ -n \"$SLURM_JOB_ID\" ]; then module --force purge; module load <MODULES>; if [ $SLURM_NTASKS != $NP ]; then echo \"job has $SLURM_NTASKS tasks but the case is decomposed into $NP\"; exit 1; fi; RUN=\"srun\"; else RUN=\"mpirun -np $NP\"; fi;",
        "pointDisplacement": "if [ -n \"$(find processor0 -mindepth 1 -maxdepth 1 -type d -regex '.*/[0-9.e+-]+' ! -name 0)\" ]; then echo 'processor0 has time directories (solver results?), the motion check would overwrite and remove them: move them away first'; exit 1; fi; for d in processor*; do mkdir -p $d/0; cp system/pointDisplacement $d/0/pointDisplacement; done;",
        "moveDynamicMesh": "echo 'running moveDynamicMesh over one cycle...'; cp system/controlDict system/controlDict.solve; trap 'cp system/controlDict.solve system/controlDict' EXIT TERM; cp system/controlDictMotion system/controlDict; $RUN moveDynamicMesh -parallel > log.moveDynamicMesh 2>&1; status=$?; cp system/controlDict.solve system/controlDict; if [ $status != 0 ]; then echo 'moveDynamicMesh failed'; exit 1; fi;",
        "checkMesh": "echo 'running checkMesh on the moved meshes...'; $RUN checkMesh -parallel -noZero > log.checkMeshMotion 2>&1; if [ $? != 0 ]; then echo 'checkMesh failed, see log.checkMeshMotion'; fi; grep -E '^Time = |Failed|Mesh OK|Max skewness|Max aspect' log.checkMeshMotion;",
        "clean": "for d in processor*; do find $d -mindepth 1 -maxdepth 1 -type d -regex '.*/[0-9.e+-]+' ! -name 0 -exec rm -rf {} +; done; echo 'motion check done (moved meshes removed)';"
    },
    "submit": {
        "shebang": "#!/bin/bash",
        "usage": "#submits the case as Slurm jobs (from the case directory)\n#  ./submitScript          mesh + solve + export in one job (continues the solve if the mesh exists)\n#  ./submitScript --check  mesh only, then the mesh motion dry run: look at it, then ./submitScript",
        "cd": "cd \"$(dirname \"$0\")\" || exit 1;",
        "check": "if [ \"$1\" = \"--check\" ]; then\njid=$(sbatch --parsable runScript --meshOnly) || exit 1; echo \"runScript --meshOnly  $jid\";",
        "motionCheck": "jid=$(sbatch --parsable --dependency=afterok:$jid motionCheckScript) || exit 1; echo \"motionCheckScript     $jid\";",
        "run": "else\njid=$(sbatch --parsable runScript) || exit 1; echo \"runScript             $jid\";\nfi;"
    }
}
