{
    "meshing": {
        "shebang": "#!/bin/bash",
        "preamble": ". $WM_PROJECT_DIR/bin/tools/RunFunctions; CORES=$(grep -i 'numberOfSubdomains' system/decomposeParDict | grep -v '//' | tr -cd '0-9');",
        "blockMesh": "echo 'running blockMesh...'; blockMesh > log.blockMesh 2>&1; if [ $? != 0 ]; then echo 'blockMesh failed'; exit 1; fi;",
        "decomposePar": "echo 'running decomposePar...'; decomposePar -force -constant > log.decomposePar 2>&1; if [ $? != 0 ]; then echo 'decomposePar failed'; exit 1; fi;",
        "snappyHexMesh": "echo 'running snappyHexMesh...'; mpirun -np $CORES snappyHexMesh -parallel -overwrite > log.snappyHexMesh 2>&1; if [ $? != 0 ]; then echo 'snappyHexMesh failed'; exit 1; fi;",
        "topoSet": "echo 'running topoSet (motion zones)...'; mpirun -np $CORES topoSet -parallel > log.topoSet 2>&1; if [ $? != 0 ]; then echo 'topoSet failed'; exit 1; fi;",
        "reorderFaceZones": "echo 'reordering faceZones (motion zones first)...'; python3 '<EXEC_DIR>/meshUtilities/reorderFaceZones.py' <MOTION_ZONES> > log.reorderFaceZones 2>&1; if [ $? != 0 ]; then cat log.reorderFaceZones; exit 1; fi;",
        "checkMesh": "echo 'running checkMesh...'; mpirun -np $CORES checkMesh -parallel > log.checkMesh 2>&1; grep -E 'cells:|Failed|Mesh OK' log.checkMesh;"
    },
    "motionCheck": {
        "shebang": "#!/bin/bash",
        "preamble": ". $WM_PROJECT_DIR/bin/tools/RunFunctions; CORES=$(grep -i 'numberOfSubdomains' system/decomposeParDict | grep -v '//' | tr -cd '0-9');",
        "pointDisplacement": "if [ -n \"$(find processor0 -mindepth 1 -maxdepth 1 -type d -regex '.*/[0-9.e+-]+' ! -name 0)\" ]; then echo 'processor0 has time directories (solver results?), the motion check would overwrite and remove them: move them away first'; exit 1; fi; for d in processor*; do mkdir -p $d/0; cp system/pointDisplacement $d/0/pointDisplacement; done;",
        "moveDynamicMesh": "echo 'running moveDynamicMesh over one cycle...'; cp system/controlDict system/controlDict.solve; cp system/controlDictMotion system/controlDict; mpirun -np $CORES moveDynamicMesh -parallel > log.moveDynamicMesh 2>&1; status=$?; cp system/controlDict.solve system/controlDict; if [ $status != 0 ]; then echo 'moveDynamicMesh failed'; exit 1; fi;",
        "checkMesh": "echo 'running checkMesh on the moved meshes...'; mpirun -np $CORES checkMesh -parallel -noZero > log.checkMeshMotion 2>&1; if [ $? != 0 ]; then echo 'checkMesh failed, see log.checkMeshMotion'; fi; grep -E '^Time = |Failed|Mesh OK|Max skewness|Max aspect' log.checkMeshMotion;",
        "clean": "for d in processor*; do find $d -mindepth 1 -maxdepth 1 -type d -regex '.*/[0-9.e+-]+' ! -name 0 -exec rm -rf {} +; done; echo 'motion check done (moved meshes removed)';"
    },
    "solve": {
        "shebang": "#!/bin/bash",
        "preamble": ". $WM_PROJECT_DIR/bin/tools/RunFunctions; CORES=$(grep -i 'numberOfSubdomains' system/decomposeParDict | grep -v '//' | tr -cd '0-9'); caseTemplates='<ZERO_TEMPLATES>';",
        "createZeroDir": "if [ ! -f processor0/0/p ]; then echo 'creating zero directories...'; mpirun -np $CORES createZeroDirectory -parallel -templateDir \"$caseTemplates\" > log.createZeroDirectory 2>&1; if [ $? != 0 ]; then echo 'createZeroDirectory failed'; exit 1; fi; fi;",
        "pointDisplacement": "for d in processor*; do cp system/pointDisplacement $d/0/pointDisplacement; done;",
        "solve": "echo 'running <SOLVER>...'; mpirun -np $CORES <SOLVER> -parallel > log.<SOLVER> 2>&1; if [ $? != 0 ]; then echo '<SOLVER> failed'; exit 1; fi;"
    }
}
