FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "templates";
    object      wallOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

wallFunction
{
    allReynolds
    {
        nut
        {
            type        nutUSpaldingWallFunction;
            value       ${:VALUE.nut};
        }
        k
        {
            type        kqRWallFunction;
            value       ${:VALUE.k};
        }
        epsilon
        {
            type        epsilonWallFunction;
            value       ${:VALUE.epsilon};
        }
        omega
        {
            type        omegaWallFunction;
            value       ${:VALUE.omega};
        }
        
        nuTilda
        {
            type        fixedValue;
            value       uniform 0;
        }
        
        
    }
    highReynolds
    {
        nut
        {
            type        nutkWallFunction;
            value       ${:VALUE.nut};
        }
        k
        {
            type        kqRWallFunction;
            value       ${:VALUE.k};
        }
        epsilon
        {
            type        epsilonWallFunction;
            value       ${:VALUE.epsilon};
        }
        omega
        {
            type        omegaWallFunction;
            value       ${:VALUE.omega};
        }
        
        nuTilda
        {
            type        fixedValue;
            value       uniform 0;
        }
        
        
    }
    lowReynolds
    {
        nut
        {
            type        nutLowReWallFunction;
            value       uniform 0;
        }
        k
        {
            type        fixedValue;
            value       uniform 0;
        }
        epsilon
        {
            type        fixedValue;
            value       uniform 1e-8;
        }
        omega
        {
            type        fixedValue;
            value       uniform 1e-8;
        }
        
        nuTilda
        {
            type        fixedValue;
            value       uniform 0;
        }
    }
    //internal flows, resolved walls: omega from omegaWallFunction (6 nu/(beta1 y^2) in the viscous sublayer, blended
    //with the log layer) instead of a fixed 1e-8, which held omega near zero at the walls and blew up kOmegaSST
    lowReynoldsInternal
    {
        nut
        {
            type        nutLowReWallFunction;
            value       uniform 0;
        }
        k
        {
            type        fixedValue;
            value       uniform 1e-10;
        }
        epsilon
        {
            type        epsilonWallFunction;
            value       ${:VALUE.epsilon};
        }
        omega
        {
            type        omegaWallFunction;
            value       ${:VALUE.omega};
        }
        nuTilda
        {
            type        fixedValue;
            value       uniform 0;
        }
    }
}


motion
{
    stationary
    {
        Urel
        {
            type        fixedValue;
            value       uniform (0 0 0);
        }
        U
        {
            type        fixedValue;
            value       uniform (0 0 0);
        }
    }
    moving
    {
        Urel
        {
            type        fixedValue;
            value       ${:VALUE.U};
        }
        U
        {
            type        fixedValue;
            value       ${:VALUE.U};
        }
    }
    slidingMesh
    {
        //static wall in a moving mesh: velocity normal to the face from the mesh flux, no tangential velocity
        //(slidingWallVelocity in foamLibs/stirlingMotion, the case loads the library in controlDict)
        Urel
        {
            type        slidingWallVelocity;
            value       uniform (0 0 0);
        }
        U
        {
            type        slidingWallVelocity;
            value       uniform (0 0 0);
        }
    }
    movingMesh
    {
        Urel
        {
            type        movingWallVelocity;
            value       ${:VALUE.U};
        }
        U
        {
            type        movingWallVelocity;
            value       ${:VALUE.U};
        }
    }
    
    rotating
    {
        Urel
        {
            type        rotatingWallVelocity;
            origin       ${:VALUE.origin};
            axis       ${:VALUE.axis};
            omega       ${:VALUE.rotVel};
        }
        U
        {
            type        rotatingWallVelocity;
            origin       ${:VALUE.origin};
            axis       ${:VALUE.axis};
            omega       ${:VALUE.rotVel};
        }
    }

    srf
    {
        Urel
        {
            type        SRFVelocity;
            inletValue  uniform (0 0 0);
            relative    false;
            value       uniform (0 0 0);
        }
        U
        {
            type        SRFVelocity;
            inletValue  uniform (0 0 0);
            relative    false;
            value       uniform (0 0 0);
        }
    }
}


