FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "templates";
    object      wallOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

wallFunction
{
    highReynolds
    {
        alphat
        {
            type        compressible::alphatWallFunction;
            value       ${:VALUE.alphat};
        }
    }
    lowReynolds
    {
        alphat
        {
            type        fixedValue;
            value       uniform 0;
        }
    }
    lowReynoldsInternal
    {
        alphat
        {
            type        fixedValue;
            value       uniform 0;
        }
    }
}


heatTransfer
{
    adiabatic
    {
        T
        {
            type        zeroGradient;
        }
    }
    fixedTemperature
    {
        T
        {
            type        fixedValue;
            value       ${:VALUE.T};
        }
    }
    //heat transfer to an ambient through h (W/m2/K) and Ta (K)
    convective
    {
        T
        {
            type        externalWallHeatFluxTemperature;
            mode        coefficient;
            h           constant ${:VALUE.h};
            Ta          constant ${:VALUE.Ta};
            kappaMethod fluidThermo;
            value       ${:VALUE.T};
        }
    }
    //fixed heat flux q (W/m2, positive into the fluid)
    heatFlux
    {
        T
        {
            type        externalWallHeatFluxTemperature;
            mode        flux;
            q           uniform ${:VALUE.q};
            kappaMethod fluidThermo;
            value       ${:VALUE.T};
        }
    }
    thermalCoupled
    {
        T
        {
            type        compressible::turbulentTemperatureRadCoupledMixed;
            value       ${:VALUE.T};
            Tnbr        T;
            kappaMethod fluidThermo;
            kappa       none;
        }
    }
}


